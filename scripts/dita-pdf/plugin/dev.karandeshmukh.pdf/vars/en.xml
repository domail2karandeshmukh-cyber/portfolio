<?xml version="1.0" encoding="UTF-8"?>
<!-- Each chapter of a house publication is a document in its own right (a quick start, a reference, a troubleshooting
     guide), so its title stands alone: no "Chapter 1" above it and no "Chapter 1:" in front of it in the contents.
     The theme (scripts/dita-pdf/theme.yaml) turns the chapter numbers off; these turn the word off. -->
<variables>
  <variable id="Chapter with number"></variable>
  <variable id="Table of Contents Chapter"></variable>
  <!-- Title Case, the house style for headings (standards/editorial.md): the labels DITA-OT writes above a task's
       sections and above related links are headings too. -->
  <variable id="task_prereq">Before You Begin</variable>
  <variable id="task_context">About This Task</variable>
  <variable id="task_postreq">What to Do Next</variable>
  <variable id="Related concepts">Related Concepts</variable>
  <variable id="Related information">Related Information</variable>
  <variable id="Related reference">Related Reference</variable>
  <variable id="Related tasks">Related Tasks</variable>
  <variable id="Related links">Related Links</variable>
</variables>
