<reqSupplies><noSupplies/></reqSupplies>
<reqSpares><spareDescrGroup><spareDescr id="spa-0001"><name>Filter element</name><identNumber><manufacturerCode>0DEMO</manufacturerCode><partAndSerialNumber><partNumber>ARF-3100</partNumber></partAndSerialNumber></identNumber><reqQuantity>1</reqQuantity></spareDescr></spareDescrGroup></reqSpares>
<reqSafety><noSafety/></reqSafety>
</preliminaryRqmts>
<mainProcedure>
<figure id="fig-0001"><title>Air filter - examination</title><graphic infoEntityIdent="ICN-0DEMO-ARF0003-001-01"></graphic></figure>
<proceduralStep id="stp-0001"><para>Look at the differential pressure indicator (9). Refer to <internalRef internalRefId="fig-0001" internalRefTargetType="irtt01"/>.</para></proceduralStep>
<proceduralStep id="stp-0002"><note><notePara>The red band shows that the filter element is blocked.</notePara></note><para>If the indicator shows a red band, record the result.</para></proceduralStep>
<proceduralStep id="stp-0003"><para>Release the clamp (8).</para></proceduralStep>
<proceduralStep id="stp-0004"><para>Remove the cover of the filter housing (6).</para></proceduralStep>
<proceduralStep id="stp-0005"><para>Remove the filter element (7).</para></proceduralStep>
<proceduralStep id="stp-0006"><para>Examine the filter element (7) for damage and contamination. Refer to <internalRef internalRefId="tab-0001" internalRefTargetType="irtt02"/>.</para><table id="tab-0001"><title>Filter element - results of the examination</title>
<tgroup cols="2"><colspec colname="col1"/><colspec colname="col2"/>
<thead><row><entry><para>Condition of the filter element</para></entry><entry><para>Action</para></entry></row></thead>
<tbody>
<row><entry><para>Clean. No damage.</para></entry><entry><para>Install the filter element again.</para></entry></row>
<row><entry><para>Dust on the upstream surface only</para></entry><entry><para>Install the filter element again. Record the condition.</para></entry></row>
<row><entry><para>Torn, wet or with dust on the downstream surface</para></entry><entry><para>Install a new filter element (7).</para></entry></row>
</tbody></tgroup></table></proceduralStep>
<proceduralStep id="stp-0007"><para>Install the filter element (7) in the filter housing (6).</para></proceduralStep>
<proceduralStep id="stp-0008"><para>Install the cover of the filter housing (6).</para></proceduralStep>
<proceduralStep id="stp-0009"><para>Engage the clamp (8).</para></proceduralStep>
<proceduralStep id="stp-0010"><para>Push the reset button of the differential pressure indicator (9).</para></proceduralStep>
<proceduralStep id="stp-0011"><para>Make sure that the indicator shows a green band.</para></proceduralStep>
</mainProcedure>
<closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
</procedure>
