<procedure>
<preliminaryRqmts>
<reqCondGroup><reqCondDm><reqCond>The fan assembly is removed.</reqCond><dmRef><dmRefIdent><dmCode modelIdentCode="ARFRIG" systemDiffCode="A" systemCode="20" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="520" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent></dmRef></reqCondDm></reqCondGroup>
<reqSupportEquips><supportEquipDescrGroup><supportEquipDescr id="seq-0001"><name>Screwdriver, cross-head, size 2</name><reqQuantity>1</reqQuantity></supportEquipDescr><supportEquipDescr id="seq-0002"><name>Torque screwdriver, 1 N.m to 5 N.m</name><reqQuantity>1</reqQuantity></supportEquipDescr></supportEquipDescrGroup></reqSupportEquips>
<reqSupplies><noSupplies/></reqSupplies>
<reqSpares><noSpares/></reqSpares>
<reqSafety><safetyRqmts><warning><warningAndCautionPara>Disconnect the bench power supply before you touch the fan assembly. The fan blades can turn and cause injury to your fingers.</warningAndCautionPara></warning></safetyRqmts></reqSafety>
</preliminaryRqmts>
<mainProcedure>
<figure id="fig-0001"><title>Fan assembly - removal and installation</title><graphic infoEntityIdent="ICN-0DEMO-ARF0002-001-01"></graphic></figure>
<proceduralStep id="stp-0001"><para>Put the fan assembly (1) in its position on the frame.</para></proceduralStep>
<proceduralStep id="stp-0002"><para>Install the four washers (3) and the four screws (2). Refer to <internalRef internalRefId="fig-0001" internalRefTargetType="irtt01"/>.</para></proceduralStep>
<proceduralStep id="stp-0003"><para>Torque the four screws (2) to 2.5 N.m.</para></proceduralStep>
<proceduralStep id="stp-0004"><para>Connect the connector (11) to the fan assembly (1).</para></proceduralStep>
<proceduralStep id="stp-0005"><para>Close the access panel.</para></proceduralStep>
<proceduralStep id="stp-0006"><para>Do a function test of the fan assembly. Refer to <dmRef><dmRefIdent><dmCode modelIdentCode="ARFRIG" systemDiffCode="A" systemCode="20" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="340" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent><dmRefAddressItems><dmTitle><techName>Fan assembly</techName><infoName>Function test</infoName></dmTitle></dmRefAddressItems></dmRef>.</para></proceduralStep>
</mainProcedure>
<closeRqmts><reqCondGroup><reqCondNoRef><reqCond>The fan assembly is installed and the function test is satisfactory.</reqCond></reqCondNoRef></reqCondGroup></closeRqmts>
