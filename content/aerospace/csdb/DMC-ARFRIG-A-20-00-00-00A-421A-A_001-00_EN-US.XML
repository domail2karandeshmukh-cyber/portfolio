<content>
<faultIsolation>
<faultIsolationProcedure>
<isolationProcedure>
<preliminaryRqmts>
<reqCondGroup><reqCondNoRef><reqCond>The fan does not run when the power switch S1 is ON.</reqCond></reqCondNoRef></reqCondGroup>
<reqSupportEquips><supportEquipDescrGroup><supportEquipDescr id="seq-0001"><name>Bench power supply, 24 V DC</name><identNumber><manufacturerCode>0DEMO</manufacturerCode><partAndSerialNumber><partNumber>ARF-GSE-01</partNumber></partAndSerialNumber></identNumber><reqQuantity>1</reqQuantity></supportEquipDescr></supportEquipDescrGroup></reqSupportEquips>
<reqSupplies><noSupplies/></reqSupplies>
<reqSpares><noSpares/></reqSpares>
<reqSafety><safetyRqmts><warning><warningAndCautionPara>Disconnect the bench power supply before you touch the fan assembly. The fan blades can turn and cause injury to your fingers.</warningAndCautionPara></warning></safetyRqmts></reqSafety>
</preliminaryRqmts>
<isolationMainProcedure>
<figure id="fig-0001"><title>Control box - controls and indicators</title><graphic infoEntityIdent="ICN-0DEMO-ARF0006-001-01"></graphic></figure>
<isolationStep id="stp-0001"><action>Connect the bench power supply. Set the power switch S1 to ON. Refer to <internalRef internalRefId="fig-0001" internalRefTargetType="irtt01"/>.</action><isolationStepQuestion>Does the POWER lamp DS1 come on?</isolationStepQuestion><isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0003"/><noAnswer nextActionRefId="stp-0002"/></yesNoAnswer></isolationStepAnswer></isolationStep>
<isolationStep id="stp-0002"><action>Look at the circuit breaker CB1.</action><isolationStepQuestion>Is the button of CB1 out?</isolationStepQuestion><isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-0001"/><noAnswer nextActionRefId="end-0002"/></yesNoAnswer></isolationStepAnswer></isolationStep>
<isolationStep id="stp-0003"><action>Turn the speed control R1 to MAX.</action><isolationStepQuestion>Does the fan run?</isolationStepQuestion><isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-0003"/><noAnswer nextActionRefId="stp-0004"/></yesNoAnswer></isolationStepAnswer></isolationStep>
<isolationStep id="stp-0004"><action>Look at the FAN FAULT lamp DS2.</action><isolationStepQuestion>Does DS2 come on?</isolationStepQuestion><isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="stp-0005"/><noAnswer nextActionRefId="end-0004"/></yesNoAnswer></isolationStepAnswer></isolationStep>
<isolationStep id="stp-0005"><action>Set the power switch S1 to OFF. Disconnect the bench power supply. Disconnect the fan harness connector from the fan assembly. Examine the pins of the connector.</action><isolationStepQuestion>Are all pins straight and clean?</isolationStepQuestion><isolationStepAnswer><yesNoAnswer><yesAnswer nextActionRefId="end-0005"/><noAnswer nextActionRefId="end-0006"/></yesNoAnswer></isolationStepAnswer></isolationStep>
<isolationProcedureEnd id="end-0001"><action>Push the button of CB1 to reset it. If CB1 opens again, replace the control box. Then do this procedure again.</action></isolationProcedureEnd>
<isolationProcedureEnd id="end-0002"><action>Make sure that the bench power supply is set to 24 V DC and is on. If it is, replace the control box.</action></isolationProcedureEnd>
<isolationProcedureEnd id="end-0003"><action>The fan runs at MAX. Do the function test of the fan assembly. Refer to <dmRef><dmRefIdent><dmCode modelIdentCode="ARFRIG" systemDiffCode="A" systemCode="20" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="340" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent><dmRefAddressItems><dmTitle><techName>Fan assembly</techName><infoName>Function test</infoName></dmTitle></dmRefAddressItems></dmRef>.</action></isolationProcedureEnd>
<isolationProcedureEnd id="end-0004"><action>Replace the control box. Then do the function test of the fan assembly.</action></isolationProcedureEnd>
<isolationProcedureEnd id="end-0005"><action>Replace the fan assembly. Refer to <dmRef><dmRefIdent><dmCode modelIdentCode="ARFRIG" systemDiffCode="A" systemCode="20" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="520" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent><dmRefAddressItems><dmTitle><techName>Fan assembly</techName><infoName>Remove procedure</infoName></dmTitle></dmRefAddressItems></dmRef> and <dmRef><dmRefIdent><dmCode modelIdentCode="ARFRIG" systemDiffCode="A" systemCode="20" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="720" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent><dmRefAddressItems><dmTitle><techName>Fan assembly</techName><infoName>Install procedure</infoName></dmTitle></dmRefAddressItems></dmRef>.</action></isolationProcedureEnd>
<isolationProcedureEnd id="end-0006"><action>Clean or straighten the pins. If a pin is broken, replace the connector. Then do this procedure again.</action></isolationProcedureEnd>
</isolationMainProcedure>
<closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
</isolationProcedure>
</faultIsolationProcedure>
</faultIsolation>
