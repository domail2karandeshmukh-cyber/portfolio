<content>
<procedure>
<preliminaryRqmts>
<reqCondGroup><reqCondNoRef><reqCond>The rig is on a stable bench.</reqCond></reqCondNoRef></reqCondGroup>
<reqSupportEquips><supportEquipDescrGroup>
<supportEquipDescr id="seq-0001"><name>Bench power supply, 24 V DC</name><reqQuantity>1</reqQuantity></supportEquipDescr>
</supportEquipDescrGroup></reqSupportEquips>
<reqSupplies><noSupplies/></reqSupplies>
<reqSpares><noSpares/></reqSpares>
<reqSafety><safetyRqmts><warning><warningAndCautionPara>Keep the access panel closed when the fan operates. The fan blades can turn and cause injury to your fingers.</warningAndCautionPara></warning></safetyRqmts></reqSafety>
</preliminaryRqmts>
<mainProcedure>
<proceduralStep id="stp-0100"><title>Start the rig</title><para>Do the steps that follow.</para>
<proceduralStep id="stp-0001"><para>Make sure that the access panel is closed.</para></proceduralStep>
<proceduralStep id="stp-0002"><para>Connect the bench power supply <internalRef internalRefId="seq-0001" internalRefTargetType="irtt05"/> to the power connector of the control box.</para></proceduralStep>
<proceduralStep id="stp-0003"><para>Set the speed control R1 to MIN.</para></proceduralStep>
<proceduralStep id="stp-0004"><para>Set the power switch S1 to ON.</para></proceduralStep>
<proceduralStep id="stp-0005"><para>Make sure that the POWER lamp DS1 comes on.</para></proceduralStep>
<proceduralStep id="stp-0006"><para>Turn the speed control R1 clockwise until the pointer of the airflow indicator is in the green band.</para></proceduralStep>
<proceduralStep id="stp-0007"><para>Make sure that the FAN FAULT lamp DS2 is off.</para></proceduralStep>
</proceduralStep>
<proceduralStep id="stp-0200"><title>Stop the rig</title><para>Do the steps that follow.</para>
<proceduralStep id="stp-0010"><para>Set the speed control R1 to MIN.</para></proceduralStep>
<proceduralStep id="stp-0011"><para>Set the power switch S1 to OFF.</para></proceduralStep>
<proceduralStep id="stp-0012"><para>Disconnect the bench power supply.</para></proceduralStep>
</proceduralStep>
</mainProcedure>
<closeRqmts><reqCondGroup><noConds/></reqCondGroup></closeRqmts>
