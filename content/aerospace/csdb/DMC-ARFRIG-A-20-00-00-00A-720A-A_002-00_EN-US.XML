<reqSpares><noSpares/></reqSpares>
<reqSafety><safetyRqmts><warning><warningAndCautionPara>Disconnect the bench power supply before you touch the fan assembly. The fan blades can turn and cause injury to your fingers.</warningAndCautionPara></warning></safetyRqmts></reqSafety>
</preliminaryRqmts>
<mainProcedure>
<figure id="fig-0001" applicRefId="app-pre-m01"><title>Fan assembly - removal and installation (before Modification M01)</title><graphic infoEntityIdent="ICN-0DEMO-ARF0002-001-01"></graphic></figure><figure id="fig-0002" applicRefId="app-post-m01" changeType="add" changeMark="1" reasonForUpdateRefIds="rfu-0001"><title>Fan assembly - removal and installation (after Modification M01)</title><graphic infoEntityIdent="ICN-0DEMO-ARF0005-001-01"></graphic></figure>
<proceduralStep id="stp-0001"><para>Put the fan assembly (1) in its position on the frame.</para></proceduralStep>
<proceduralStep id="stp-0002" applicRefId="app-pre-m01" changeType="modify" changeMark="1" reasonForUpdateRefIds="rfu-0001"><para>Install the four washers (3) and the four screws (2). Refer to <internalRef internalRefId="fig-0001" internalRefTargetType="irtt01"/>.</para></proceduralStep>
<proceduralStep id="stp-0003" applicRefId="app-pre-m01" changeType="modify" changeMark="1" reasonForUpdateRefIds="rfu-0001"><para>Torque the four screws (2) to 2.5 N.m.</para></proceduralStep>
<proceduralStep id="stp-0004" applicRefId="app-post-m01" changeType="add" changeMark="1" reasonForUpdateRefIds="rfu-0001"><para>Close the two latches (4). Refer to <internalRef internalRefId="fig-0002" internalRefTargetType="irtt01"/>.</para></proceduralStep>
<proceduralStep id="stp-0005" applicRefId="app-post-m01" changeType="add" changeMark="1" reasonForUpdateRefIds="rfu-0001"><note><notePara>A locked latch is flat against the bracket.</notePara></note><para>Make sure that each latch is locked.</para></proceduralStep>
<proceduralStep id="stp-0006"><para>Connect the connector (11) to the fan assembly (1).</para></proceduralStep>
<proceduralStep id="stp-0007"><para>Close the access panel.</para></proceduralStep>
<proceduralStep id="stp-0008"><para>Do a function test of the fan assembly. Refer to <dmRef><dmRefIdent><dmCode modelIdentCode="ARFRIG" systemDiffCode="A" systemCode="20" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="340" infoCodeVariant="A" itemLocationCode="A"/></dmRefIdent><dmRefAddressItems><dmTitle><techName>Fan assembly</techName><infoName>Function test</infoName></dmTitle></dmRefAddressItems></dmRef>.</para></proceduralStep>
</mainProcedure>
<closeRqmts><reqCondGroup><reqCondNoRef><reqCond>The fan assembly is installed and the function test is satisfactory.</reqCond></reqCondNoRef></reqCondGroup></closeRqmts>
</procedure>
