  {
   "id": "feedback-no-token",
   "title": "Send feedback without a token",
   "query": "mutation SendFeedback($input: SubmitFeedbackInput!) {\n  submitFeedback(input: $input) {\n    __typename\n  }\n}",
   "variables": {
    "input": {
     "documentId": "kc-reset-otp",
     "helpful": true
    }
   },
   "response": {
    "status": 200,
    "body": {
     "errors": [
      {
       "message": "Send an access token: Authorization: Bearer <token>.",
       "locations": [
        {
         "line": 2,
         "column": 3
        }
       ],
       "path": [
        "submitFeedback"
       ],
       "extensions": {
        "code": "UNAUTHENTICATED"
       }
      }
     ],
     "data": null
    }
   }
  },
  {
   "id": "feedback",
   "title": "Send feedback",
   "token": true,
   "query": "mutation SendFeedback($input: SubmitFeedbackInput!) {\n  submitFeedback(input: $input) {\n    __typename\n    ... on SubmitFeedbackSuccess {\n      feedback { id documentId helpful comment }\n    }\n    ... on Problem { message }\n  }\n}",
   "variables": {
    "input": {
     "documentId": "kc-reset-otp",
     "helpful": false,
     "comment": "Step 5 doesn't say what to do if the user has other required actions."
    }
   },
   "response": {
    "status": 200,
    "body": {
     "data": {
      "submitFeedback": {
       "__typename": "SubmitFeedbackSuccess",
       "feedback": {
        "id": "fb-1",
        "documentId": "kc-reset-otp",
        "helpful": false,
        "comment": "Step 5 doesn't say what to do if the user has other required actions."
       }
      }
     }
    }
   }
  },
  {
   "id": "feedback-unknown-document",
   "title": "Send feedback on a document that doesn't exist",
   "token": true,
   "query": "mutation SendFeedback($input: SubmitFeedbackInput!) {\n  submitFeedback(input: $input) {\n    __typename\n    ... on Problem { message }\n    ... on DocumentNotFoundProblem { documentId }\n  }\n}",
   "variables": {
    "input": {
     "documentId": "kc-reset-2fa",
     "helpful": true
    }
   },
   "response": {
    "status": 200,
    "body": {
     "data": {
      "submitFeedback": {
       "__typename": "DocumentNotFoundProblem",
       "message": "No document has this ID.",
       "documentId": "kc-reset-2fa"
      }
     }
    }
   }
  },
  {
   "id": "feedback-long-comment",
   "title": "Send a comment that is too long",
   "token": true,
   "query": "mutation SendFeedback($input: SubmitFeedbackInput!) {\n  submitFeedback(input: $input) {\n    __typename\n    ... on Problem { message }\n    ... on CommentTooLongProblem { maxLength }\n  }\n}",
   "variables": {
    "input": {
     "documentId": "kc-reset-otp",
     "helpful": false,
     "comment": ""
    }
   },
   "response": {
    "status": 200,
    "body": {
     "data": {
      "submitFeedback": {
       "__typename": "CommentTooLongProblem",
       "message": "The comment is longer than 500 characters.",
       "maxLength": 500
      }
     }
    }
   }
  },
