{
 "about": "Every example of the library API's guide. scripts/graphql-examples.mjs sends each one to a fresh server and compares the answer with `response`; the build fails if one differs. Run it with --record to rewrite the responses after a deliberate change.",
 "endpoint": "http://localhost:4000/graphql",
 "token": "local-demo-token",
 "examples": [
  {
   "id": "first-page",
   "title": "Read the first page of documents",
   "query": "query FirstPage {\n  documents(first: 3) {\n    totalCount\n    edges {\n      cursor\n      node { id title kind }\n    }\n    pageInfo { hasNextPage endCursor }\n  }\n}",
   "response": {
    "status": 200,
    "body": {
     "data": {
      "documents": {
       "totalCount": 25,
       "edges": [
        {
         "cursor": "ZG9jOjA=",
         "node": {
          "id": "cg-threat",
          "title": "Threat model",
          "kind": "SECURITY"
         }
        },
        {
         "cursor": "ZG9jOjE=",
         "node": {
          "id": "tn-demo",
          "title": "The demonstration in two minutes",
          "kind": "HOW_TO"
         }
        },
        {
         "cursor": "ZG9jOjI=",
         "node": {
          "id": "tn-how",
          "title": "How TrustNav works, step by step",
          "kind": "CONCEPT"
         }
        }
       ],
       "pageInfo": {
        "hasNextPage": true,
        "endCursor": "ZG9jOjI="
       }
      }
     }
    }
   }
  },
  {
   "id": "next-page",
   "title": "Read the next page",
   "query": "query NextPage($after: String) {\n  documents(first: 3, after: $after) {\n    edges { node { id title } }\n    pageInfo { hasPreviousPage hasNextPage endCursor }\n  }\n}",
   "variables": {
    "after": "ZG9jOjI="
   },
   "response": {
    "status": 200,
    "body": {
     "data": {
      "documents": {
       "edges": [
        {
         "node": {
          "id": "studio-shots-guide",
          "title": "Annotate a screenshot in the Screenshot Studio"
         }
        },
        {
         "node": {
          "id": "kc1-model-card",
          "title": "Model card: KC1 defect prediction"
         }
        },
        {
         "node": {
          "id": "kc1-dataset-card",
          "title": "Dataset card: NASA PROMISE KC1, as the KC1 project uses it"
         }
        }
       ],
       "pageInfo": {
        "hasPreviousPage": true,
        "hasNextPage": true,
        "endCursor": "ZG9jOjU="
       }
      }
     }
    }
   }
  },
  {
   "id": "filter-kind",
   "title": "Keep one kind of document",
