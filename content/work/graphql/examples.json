  {
   "id": "one-document",
   "title": "Read one document",
   "query": "query OneDocument($id: ID!) {\n  document(id: $id) { title kind project url }\n}",
   "variables": {
    "id": "kc-reset-otp"
   },
   "response": {
    "status": 200,
    "body": {
     "data": {
      "document": {
