{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/april.js": { "maxDuration": 30 },
    "api/rewrite.js": { "maxDuration": 30, "includeFiles": "content/desk/**" },
    "api/s1000d.js": { "maxDuration": 30, "includeFiles": "content/aerospace/csdb/DMC-ARFRIG-A-20-00-00-00A-520A-A_002-00_EN-US.XML" }
  },
  "redirects": [
    { "source": "/rewrite", "destination": "/#rewrite", "permanent": false },
    { "source": "/write", "destination": "/workbench", "permanent": false }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/voice/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(samples|docs)/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/thumbs/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/docs/files/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
