{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "jsx": "react-jsx", "types": ["node"], "skipLibCheck": true
  },
  "include": ["src", "ui", "tests", "data/build.ts"]
}
